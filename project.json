{
  "name": "BoilerLinkWatch",
  "options": {
    "bundleIdPrefix": "ua.boilermonitor",
    "deploymentTarget": {
      "iOS": "17.0"
    }
  },
  "settings": {
    "base": {
      "SWIFT_VERSION": "5.0",
      "TARGETED_DEVICE_FAMILY": "1,2",
      "CODE_SIGNING_ALLOWED": "NO"
    }
  },
  "targets": {
    "LinkWatch": {
      "type": "application",
      "platform": "iOS",
      "sources": [
        "LinkWatch"
      ],
      "info": {
        "path": "LinkWatch/Info.plist",
        "properties": {
          "BGTaskSchedulerPermittedIdentifiers": [
            "ua.boilermonitor.linkwatch.refresh"
          ],
          "CFBundleDisplayName": "Зв’язок котелень",
          "CFBundleShortVersionString": "0.1",
          "CFBundleVersion": "1",
          "UIApplicationSceneManifest": {
            "UIApplicationSupportsMultipleScenes": false
          },
          "UIBackgroundModes": [
            "fetch"
          ],
          "UILaunchScreen": {},
          "UISupportedInterfaceOrientations": [
            "UIInterfaceOrientationPortrait",
            "UIInterfaceOrientationLandscapeLeft",
            "UIInterfaceOrientationLandscapeRight"
          ]
        }
      },
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "ua.boilermonitor.linkwatch",
          "GENERATE_INFOPLIST_FILE": "NO"
        }
      }
    }
  }
}